# Postgres. Locally: the plain Postgres 16 that `pnpm setup` creates. On Supabase: the project's
# direct connection string (the app talks to Postgres directly and sets the caller's role per request).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/axiom

# Supabase Auth (production). Leave unset locally; the dev sign-in signs sessions with AUTH_SECRET.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The seeded sign-in, inlined at build time. Leave it out of a deployment's build and that build
# has no dev door at all — no runtime variable can add one back.
#
# It is commented out on purpose. A build that carries it serves /sign-in as a list of every user,
# each a one-click session, to anyone who asks. Uncomment it for local work and for CI, which needs
# the seeded sign-in to drive the browser gates; never for anything reachable from the internet.
# `scripts/gates/grep.mjs` fails the build if this line is ever left enabled here.
# NEXT_PUBLIC_AUTH_MODE=dev
AUTH_SECRET=change-me-locally

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
