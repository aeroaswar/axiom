# Postgres. Locally: the plain Postgres 16 that `pnpm setup` creates. On Supabase: the project's
# direct connection string (the app talks to Postgres directly and sets the caller's role per request).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/axiom

# Supabase Auth (production). Leave unset locally: AUTH_MODE=dev signs sessions with AUTH_SECRET.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_MODE=dev
AUTH_SECRET=change-me-locally

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
